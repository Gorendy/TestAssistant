<Window x:Class="TestClient.MsgDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="信息提示" Height="160" Width="300"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F7F8FA" BorderThickness="0" 
        AllowsTransparency="True" WindowStyle="None">
    <Grid>
        <!-- 主边框 -->
        <Border Background="LightYellow" CornerRadius="8" Margin="10" BorderBrush="#DADCE0" BorderThickness="1">
            <Grid>
                <!-- 内容区域 -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 标题 -->
                <TextBlock x:Name="TitleText" Text="Message" FontSize="18" FontWeight="Bold" Foreground="#2E3A59"
                           Margin="5,5,0,5" HorizontalAlignment="Left" />
                <!-- 内容 -->
                <ScrollViewer Grid.Row="0" Margin="6,30,6,0" VerticalScrollBarVisibility="Auto" Background="LightGray">
                    <StackPanel>
                        <!-- 消息内容 -->
                        <TextBlock x:Name="MessageText" Text="这是一条提示消息。" TextWrapping="Wrap" FontSize="10" Margin="0,3,0,0"
                                   Foreground="#4A4A4A" HorizontalAlignment="Center" TextAlignment="Left" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 按钮 -->
                <DockPanel Grid.Row="1" Margin="20,2,20,5">
                    <Button x:Name="ConfirmButton" Content="确定" Width="40" Height="20" Margin="0,0,0,0"
                            HorizontalAlignment="Center" Style="{StaticResource DialogButtonStyle}"  Click="submit"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
